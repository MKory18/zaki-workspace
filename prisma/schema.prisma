// Zaki Workspace — Prisma schema (Phase 1–2: foundation + core workspace)
// Extensible: worker/AI/Telegram tables are added in later migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity ----------

model User {
  id           String   @id @default(cuid())
  // An account is created by the owner with a username + password; an e-mail address is optional
  // (moderators and warehouse staff may have none). Both are stored lower-case and are unique.
  email        String?  @unique
  username     String?  @unique
  name         String
  passwordHash String
  // Bumped to end every session of this user at once (suspend, offboard, password reset, "log out
  // everywhere"). The session token carries the value it was issued with; a mismatch is a sign-out.
  tokenVersion Int      @default(0)
  // True while the password is a temporary one chosen by the owner: the user must change it first.
  mustChangePassword Boolean @default(false)
  // The version of the "work chats are archived and visible to the owner" notice this user accepted.
  transparencyVersion    Int?
  transparencyAcceptedAt DateTime?
  lastLoginAt  DateTime?
  // Presence for the chat: written at most once a minute while the person has a live connection.
  lastSeenAt   DateTime?
  locale       String   @default("ar") // ar | fr (en reserved)
  theme        String   @default("system") // light | dark | system
  digits       String   @default("latin") // latin | arabic: how 0-9 are drawn (src/lib/digits.ts)
  avatarUrl    String?
  jobTitle     String? // وظيفي: professional title shown on profile (e.g. "Project Manager")
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     OrganizationMember[] @relation("MemberUser")
  managedMembers  OrganizationMember[] @relation("MemberManager")
  workspaceLinks  WorkspaceMember[]
  teamLinks       TeamMember[]
  createdTasks    Task[]               @relation("TaskCreator")
  assignedTasks   Task[]               @relation("TaskAssignee")
  comments        TaskComment[]
  activity        TaskActivity[]
  notifications   Notification[]
  ideas           Idea[]               @relation("IdeaCreator")
  ideaVotes       IdeaVote[]           @relation("IdeaVoter")
  chatMemberships ConversationMember[] @relation("ChatMember")
  chatMessages    ChatMessage[]        @relation("ChatAuthor")
  chatDeletions   ChatMessage[]        @relation("ChatDeleter")
  chatReactions   ChatReaction[]
  messageRevisions MessageRevision[]   @relation("RevisionEditor")
  messageNotes    MessageNote[]        @relation("NoteAuthor")
  uploadedFiles   StoredFile[]         @relation("FileUploader")
  deptMemberships DepartmentMember[]
  createdTickets  Ticket[]             @relation("TicketCreator")
  assignedTickets Ticket[]             @relation("TicketAssignee")
  ticketComments  TicketComment[]      @relation("TicketCommentAuthor")
  ticketActivity  TicketActivity[]     @relation("TicketActivityActor")
  createdCustomers Customer[]          @relation("CustomerCreator")
  ownedOpportunities Opportunity[]    @relation("OpportunityOwner")
  routines        Routine[]            @relation("RoutineAssignee")
  goals           Goal[]               @relation("GoalCreator")
  campaigns       Campaign[]           @relation("CampaignOwner")
}

// ---------- departments (the company's pools: design / dev / IT / sales) ----------

model Department {
  id        String    @id @default(cuid())
  orgId     String
  name      String
  emoji     String?
  color     String? // tailwind-ish token for the chip
  leadId    String? // informational lead shown on the card (must be an org member)
  createdAt DateTime  @default(now())

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberships  DepartmentMember[]
  projects     Project[]
  tickets      Ticket[]
  routines     Routine[]
  goals        Goal[]
  campaigns    Campaign[]
  // The chat space of the department (Phase 3): at most one, created by the data move or on demand.
  space        Workspace?

  @@index([orgId])
}

// ---------- department products: IT tickets ----------
enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Ticket {
  id           String       @id @default(cuid())
  orgId        String
  departmentId String
  number       Int // per-org sequential → key `${prefix}-T${number}`
  title        String
  description  String?
  status       TicketStatus @default(OPEN)
  priority     TaskPriority @default(NORMAL)
  creatorId    String
  assigneeId   String?
  resolvedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  creator      User         @relation("TicketCreator", fields: [creatorId], references: [id])
  assignee     User?        @relation("TicketAssignee", fields: [assigneeId], references: [id])
  comments     TicketComment[]
  activities   TicketActivity[]

  @@unique([orgId, number])
  @@index([departmentId, status])
  @@index([orgId])
  @@index([assigneeId])
}

model TicketComment {
  id       String    @id @default(cuid())
  ticketId String
  authorId String
  body     String
  editedAt DateTime?
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation("TicketCommentAuthor", fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
}

model TicketActivity {
  id        String   @id @default(cuid())
  ticketId  String
  actorId   String
  event     String // created | status_changed | assigned | commented | edited
  meta      Json?
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User   @relation("TicketActivityActor", fields: [actorId], references: [id])

  @@index([ticketId, createdAt])
}

// ---------- department products: campaign calendar ----------
enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  DONE
  CANCELLED
}

model Campaign {
  id           String         @id @default(cuid())
  orgId        String
  departmentId String
  number       Int // per-org sequential → key `${prefix}-C${number}`
  title        String
  description  String?
  status       CampaignStatus @default(DRAFT)
  priority     TaskPriority   @default(NORMAL)
  startDate    DateTime
  endDate      DateTime
  ownerId      String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  owner        User         @relation("CampaignOwner", fields: [ownerId], references: [id])
  items        CampaignItem[]

  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([departmentId, startDate])
}

// A dated item on the campaign calendar (post / event / task-link).
model CampaignItem {
  id         String    @id @default(cuid())
  campaignId String
  title      String
  kind       String    @default("post") // post | event | task
  dueDate    DateTime
  doneAt     DateTime?
  createdAt  DateTime  @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, dueDate])
}

// ---------- daily production & goals ----------
model Routine {
  id           String   @id @default(cuid())
  orgId        String
  departmentId String?
  title        String
  description  String?
  assigneeId   String? // who performs it today ("توزيع المهام")
  weekdays     String   @default("") // csv weekday numbers 0-6 (0=Sunday); "" = every day
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignee     User?        @relation("RoutineAssignee", fields: [assigneeId], references: [id])
  logs         RoutineLog[]

  @@index([orgId])
}

model RoutineLog {
  id            String   @id @default(cuid())
  routineId     String
  day           String // local date "YYYY-MM-DD"
  completedById String
  completedAt   DateTime @default(now())

  routine Routine @relation(fields: [routineId], references: [id], onDelete: Cascade)

  @@unique([routineId, day])
  @@index([day])
}

enum GoalPeriod {
  WEEKLY
  MONTHLY
}

model Goal {
  id           String     @id @default(cuid())
  orgId        String
  title        String
  description  String?
  period       GoalPeriod
  periodStart  DateTime
  periodEnd    DateTime
  progress     Int        @default(0) // 0..100
  departmentId String?
  creatorId    String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  creator      User         @relation("GoalCreator", fields: [creatorId], references: [id])

  @@index([orgId, period])
  @@index([departmentId])
}

model DepartmentMember {
  id           String   @id @default(cuid())
  departmentId String
  userId       String
  role         String   @default("member") // lead | member
  createdAt    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([userId])
}

// ---------- file library (versioned org files; strict sniffed types) ----------

model StoredFile {
  id         String    @id @default(cuid())
  orgId      String
  uploaderId String
  familyId   String // versions share one family; equals own id for v1
  name       String // display name (original filename)
  path       String // server-relative storage path (never exposed raw)
  mimeType   String // sniffed from bytes, never trusted from client
  size       Int
  version    Int       @default(1)
  isLatest   Boolean   @default(true)
  deletedAt  DateTime?
  // Where the file belongs: LIBRARY (the file library lists only these) | CHAT (an attachment) | VOICE (a voice message).
  purpose    String    @default("LIBRARY")
  // Chat uploads carry their attachment facts here until the message claims them
  // (image width/height; voice durationMs and peaks). Null for every library file.
  meta       Json?
  createdAt  DateTime  @default(now())

  organization Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  uploader     User                @relation("FileUploader", fields: [uploaderId], references: [id], onDelete: Cascade)
  chatLinks    MessageAttachment[]

  @@index([orgId, familyId, isLatest])
  @@index([familyId])
  @@index([orgId, purpose])
}

// ---------- internal chat (Phase: real-time rooms over the org boundary) ----------

// A conversation is one of three things (`kind`):
//   DM     two people of one company; at most one per pair (`dmKey`)
//   TOPIC  a topic inside a space (`spaceId`): its audience is the space's people unless `restricted`
//   GROUP  legacy: a group of the previous release. The Phase 3 data move turns every one into a
//          space with a general TOPIC; the value stays valid for rows written by a release still running.
model Conversation {
  id            String    @id @default(cuid())
  orgId         String
  kind          String // DM | GROUP (legacy) | TOPIC
  title         String? // TOPIC / GROUP
  emoji         String? // identity marker (🎨 💻 …)
  // ---- topics (Phase 3) ----
  // The space the topic lives in. A space that has topics (chat history) can never be deleted: RESTRICT.
  spaceId       String?
  topicType     String    @default("DISCUSSION") // DISCUSSION | ANNOUNCEMENTS | TASKS | IDEAS | FOLLOWUP
  postingPolicy String    @default("ALL") // ALL | ADMINS
  // restricted: only the people with a ConversationMember row are its audience, not the whole space.
  restricted    Boolean   @default(false)
  closedAt      DateTime? // closed topics take no new messages; admins reopen
  position      Int       @default(0) // order of the topics inside the space
  // The role of a system topic: announcements | followup | general | ideas | archive (one per space).
  systemKey     String?
  // DM only: the two user ids, smaller first, joined with "|". Unique per company (a person can work in
  // two companies and has a DM with the same colleague in each). Born NULL; the data move fills it for
  // the OLDEST DM of each pair.
  dmKey         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organization Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  space        Workspace?           @relation(fields: [spaceId], references: [id], onDelete: Restrict)
  // A topic that belongs to a team of its space: its audience is that team and the space's managers.
  teamId       String?
  team         Team?                @relation(fields: [teamId], references: [id], onDelete: Restrict)
  members      ConversationMember[]
  messages     ChatMessage[]

  @@unique([orgId, dmKey])
  @@unique([spaceId, systemKey])
  @@index([orgId, updatedAt])
  @@index([spaceId, position])
  @@index([teamId])
}

model ConversationMember {
  id              String    @id @default(cuid())
  conversationId  String
  userId          String
  role            String    @default("member") // member | admin (GROUP)
  lastReadAt      DateTime  @default(now())
  // Newest moment a device of this person received the conversation (DM ticks: sent / delivered / read).
  lastDeliveredAt DateTime?
  // The person's own notification mute (Phase 5). It does NOT stop them posting: the moderators' mute is
  // WorkspaceMember.mutedUntil.
  mutedUntil      DateTime?
  joinedAt        DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation("ChatMember", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
}

model ChatMessage {
  id              String    @id @default(cuid())
  orgId           String
  conversationId  String
  authorId        String
  // Deleting a message KEEPS its text from Phase 3 on (the owner reads the original in the archive);
  // what people see is decided in one place: src/server/chat/redact.ts.
  body            String
  kind            String    @default("TEXT") // TEXT | VOICE | SYSTEM
  replyToId       String?
  pinned          Boolean   @default(false)
  editedAt        DateTime?
  deletedAt       DateTime? // tombstone: the row is kept for threads and the archive
  deletedById     String? // who deleted it (the author, a space admin or the owner)
  forwardedFromId String? // the ORIGINAL message of a forward
  mentions        String[]  @default([]) // user ids
  // Sending is idempotent: a client retry with the same clientId never creates a second message.
  clientId        String?
  createdAt       DateTime  @default(now())

  organization  Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversation  Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author        User                @relation("ChatAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  deletedBy     User?               @relation("ChatDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  replyTo       ChatMessage?        @relation("ChatReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies       ChatMessage[]       @relation("ChatReplies")
  forwardedFrom ChatMessage?        @relation("ChatForwards", fields: [forwardedFromId], references: [id], onDelete: SetNull)
  forwards      ChatMessage[]       @relation("ChatForwards")
  reactions     ChatReaction[]
  revisions     MessageRevision[]
  notes         MessageNote[]
  attachments   MessageAttachment[]

  @@unique([authorId, clientId])
  @@index([conversationId, createdAt])
  @@index([orgId, createdAt])
}

model ChatReaction {
  id        String @id @default(cuid())
  messageId String
  userId    String
  emoji     String

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// The text a message had BEFORE an edit. One row per edit; only the owner reads them.
model MessageRevision {
  id        String   @id @default(cuid())
  messageId String
  body      String
  editorId  String
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  editor  User        @relation("RevisionEditor", fields: [editorId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
}

// An internal note on a message: seen only by the admins of its space and by the owner.
model MessageNote {
  id        String   @id @default(cuid())
  messageId String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  author  User        @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
}

// A file attached to a message. The bytes are a StoredFile (purpose CHAT / VOICE), never listed in the library.
// An upload exists first and is claimed by a message afterwards: until then `messageId` is NULL (only its
// uploader can open it, and an unclaimed row older than a day is cleaned up). A forward links the same file
// again from a new message.
model MessageAttachment {
  id         String   @id @default(cuid())
  messageId  String?
  fileId     String
  kind       String // IMAGE | VIDEO | AUDIO | FILE
  name       String?
  width      Int?
  height     Int?
  durationMs Int?
  peaks      Json? // voice waveform: up to 100 integers 0..100
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  message ChatMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  file    StoredFile   @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([messageId, position])
  @@index([fileId])
}

// The bus of the chat: every change writes one row (ids only, never content) inside the same transaction;
// a trigger notifies the listener (channel zaki_rt, payload = the row id). Rows older than two days are purged.
// ⚠️ `id` is a BigInt: convert it (String(id)) before JSON.stringify, which throws on a bigint.
model RealtimeEvent {
  id        BigInt   @id @default(autoincrement())
  orgId     String
  kind      String // message.created | message.edited | ... (src/server/realtime/emit.ts)
  ids       Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([orgId, id])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  keyPrefix String   @unique // used for task keys, e.g. ZW -> ZW-42
  joinCode  String   @unique // legacy self-serve join code: no longer honoured (accounts are created by the owner)
  // The company's clock: "today", overdue and quiet hours are computed in this zone, not the server's.
  timezone  String   @default("Asia/Damascus")
  // Validated per key in code (src/server/policy/org-settings.ts): transparency notice version, etc.
  settings  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members          OrganizationMember[]
  workspaces       Workspace[]
  taskCounter      TaskCounter?
  tasks            Task[]
  ideas            Idea[]
  ideaVotes        IdeaVote[]
  integrations     Integration[]
  conversations    Conversation[]
  IntegrationEvent IntegrationEvent[]
  ChatMessage      ChatMessage[]
  files            StoredFile[]
  departments      Department[]
  tickets          Ticket[]
  customers        Customer[]
  opportunities    Opportunity[]
  routines         Routine[]
  goals            Goal[]
  campaigns        Campaign[]

  @@index([slug])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole      @default(MEMBER)
  // Only ACTIVE members can use the app. A suspended or offboarded member keeps the row (history,
  // authorship) but every guard treats them as absent.
  status         MemberStatus @default(ACTIVE)
  // Capabilities on top of / taken away from what the rank grants (src/server/policy/capabilities.ts).
  capabilities        String[] @default([])
  revokedCapabilities String[] @default([])
  // Who escalations go to (the person's manager); null = the owner.
  managerId      String?
  // The same person's reference in the OMS (staff, penalties, cash custody), for later integration.
  omsStaffRef    String?
  statusChangedAt   DateTime?
  statusChangedById String?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)
  manager      User?        @relation("MemberManager", fields: [managerId], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@unique([organizationId, omsStaffRef])
  @@index([userId])
  @@index([organizationId, status])
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
  OFFBOARDED
}

enum OrgRole {
  OWNER
  ADMIN
  // Team lead (manager-lite): hands out work to the people under them and receives escalations.
  LEAD
  MEMBER
  GUEST
}

// ---------- Workspaces / teams ----------

// A space: the place where a team works AND talks. Its topics are the conversations that point at it.
model Workspace {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  // STANDARD: made by people | DEPARTMENT: the chat of a department | HQ: the company-wide space (one per company)
  kind           WorkspaceKind @default(STANDARD)
  emoji          String?
  // The role of a system space: "hq". Unique per company, so there is exactly one HQ.
  systemKey      String?
  // DEPARTMENT spaces: the department they belong to (at most one space per department).
  departmentId   String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department    Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  notifications Notification[]
  members       WorkspaceMember[]
  teams         Team[]
  projects      Project[]
  conversations Conversation[]

  @@unique([organizationId, slug])
  @@unique([organizationId, systemKey])
  @@index([organizationId])
}

enum WorkspaceKind {
  STANDARD
  DEPARTMENT
  HQ
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  // The moderators' mute: until this moment the person cannot post in ANY topic of the space.
  // NULL = not muted; "forever" is stored as 9999-12-31.
  mutedUntil  DateTime?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

enum WorkspaceRole {
  ADMIN
  MEMBER
  GUEST
}

// A team INSIDE a space (the owner's decision, 2026-10-25: «جوّا المساحة فرق، كل فريق إله مشاريعه ومواضيعه»).
// A space with no team works exactly as before; once it has teams, a member sees the space's own work (no
// team) and the work of their teams, and the space's managers see all of it (src/server/services/team-scope.ts).
model Team {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  leadId      String?
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects      Project[]
  members       TeamMember[]
  conversations Conversation[]

  @@index([workspaceId])
}

// Who is in a team. Only people with a row in the team's space may be added (the service checks).
model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

// ---------- Projects ----------

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  AT_RISK
  COMPLETED
  ARCHIVED
}

model Project {
  id           String        @id @default(cuid())
  workspaceId  String
  name         String
  description  String?
  status       ProjectStatus @default(PLANNING)
  priority     TaskPriority  @default(NORMAL)
  ownerId      String?
  departmentId String?
  startDate    DateTime?
  targetDate   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  workspace  Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team       Team?           @relation(fields: [teamId], references: [id])
  department Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  teamId     String?
  boards     Board[]
  tasks      Task[]
  milestones Milestone[]

  @@index([workspaceId])
  @@index([status])
  @@index([departmentId])
  @@index([teamId])
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  name        String
  description String?
  status      MilestoneStatus @default(OPEN)
  ownerId     String?
  targetDate  DateTime?
  createdAt   DateTime        @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
}

enum MilestoneStatus {
  OPEN
  COMPLETED
  OVERDUE
}

// ---------- Boards / workflow ----------

model Board {
  id          String   @id @default(cuid())
  projectId   String
  name        String
  description String?
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns BoardColumn[]
  tasks   Task[]

  @@index([projectId])
}

model BoardColumn {
  id       String  @id @default(cuid())
  boardId  String
  name     String
  color    String  @default("#6b7280")
  position Int // 0..n display order
  done     Boolean @default(false) // marks terminal columns; drives "completed" semantics

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([boardId, name])
  @@index([boardId, position])
}

// ---------- Tasks ----------

enum TaskPriority {
  URGENT
  HIGH
  NORMAL
  LOW
  NONE
}

enum TaskType {
  TASK
  BUG
  FEATURE
  IMPROVEMENT
  RESEARCH
  MEETING
  CONTENT
  MARKETING
  OPERATIONS
  AUTOMATION
  AI_AGENT
}

model TaskCounter {
  organizationId String @id
  lastNumber     Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Task {
  id          String       @id @default(cuid())
  number      Int // per-organization sequential number -> key is `${prefix}-${number}`
  orgId       String
  workspaceId String
  projectId   String
  boardId     String
  columnId    String
  title       String
  description String?
  priority    TaskPriority @default(NORMAL)
  type        TaskType     @default(TASK)
  creatorId   String
  assigneeId  String?
  teamId      String?
  milestoneId String?
  dueDate     DateTime?
  startDate   DateTime?
  completedAt DateTime?
  archived    Boolean      @default(false)
  position    Decimal      @db.Decimal(22, 10)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  organization Organization     @relation(fields: [orgId], references: [id])
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  board        Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  column       BoardColumn      @relation(fields: [columnId], references: [id])
  creator      User             @relation("TaskCreator", fields: [creatorId], references: [id])
  assignee     User?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  milestone    Milestone?       @relation(fields: [milestoneId], references: [id])
  labels       TaskLabel[]
  comments     TaskComment[]
  activities   TaskActivity[]
  dependencies TaskDependency[] @relation("Task")
  blocksTask   TaskDependency[] @relation("BlockedTask")

  @@unique([orgId, number])
  @@index([workspaceId, createdAt])
  @@index([projectId, archived])
  @@index([boardId, columnId, position])
  @@index([assigneeId])
  @@index([creatorId])
  @@index([dueDate])
}

model TaskLabel {
  taskId  String
  labelId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
}

model Label {
  id    String @id @default(cuid())
  orgId String
  name  String
  color String @default("#6b7280")

  tasks TaskLabel[]

  @@unique([orgId, name])
  @@index([orgId])
}

// relationships: blocks / blockedBy / duplicates
enum TaskDependencyKind {
  BLOCKS
  BLOCKED_BY
  DUPLICATES
}

model TaskDependency {
  id          String             @id @default(cuid())
  taskId      String
  dependsOnId String
  kind        TaskDependencyKind @default(BLOCKS)

  task      Task @relation("Task", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("BlockedTask", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId, kind])
  @@index([dependsOnId])
}

model TaskComment {
  id        String    @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  editedAt  DateTime?
  createdAt DateTime  @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId, createdAt])
}

// structured events; no free-form parsing
model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  actorId   String
  event     String // created | moved | assigned | commented | due_changed | ...
  meta      Json?
  createdAt DateTime @default(now())

  task  Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id])

  @@index([taskId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // task_assigned | mentioned | due_soon | comment ...
  title     String
  body      String?
  linkUrl   String?
  taskId    String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  // The space the notification belongs to (a task's, a topic's or a DM's, a space one was added to): the bell shows
  // the space the person is in. None: personal (a welcome, a changed rank), shown in every space — and the
  // notifications from before spaces had them.
  workspaceId String?

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([userId, workspaceId, readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  orgId     String?
  action    String // auth.login | org.created | task.deleted | chat.oversight_read ...
  target    String?
  meta      Json?
  // Moderation and oversight trails (Phase 3): which space / conversation the entry is about.
  // No foreign keys on purpose: an audit row outlives what it describes.
  workspaceId    String?
  conversationId String?
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([action, createdAt])
  @@index([conversationId, createdAt])
  @@index([workspaceId, createdAt])
}

enum IdeaStatus {
  NEW
  UNDER_REVIEW
  ACCEPTED
  REJECTED
}

model Idea {
  id          String     @id @default(cuid())
  orgId       String
  creatorId   String
  title       String
  description String?
  status      IdeaStatus @default(NEW) // NEW -> UNDER_REVIEW -> ACCEPTED/REJECTED
  taskId      String? // set when converted into a real task
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator      User         @relation("IdeaCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  votes        IdeaVote[]

  @@index([orgId, status])
  @@index([orgId, createdAt])
}

model IdeaVote {
  id        String   @id @default(cuid())
  orgId     String
  ideaId    String
  userId    String
  createdAt DateTime @default(now())

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  idea         Idea         @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user         User         @relation("IdeaVoter", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ideaId, userId])
  @@index([orgId])
}

// ---------- integrations (per org, secrets stored AES-256-GCM-encrypted) ----------

enum IntegrationType {
  TELEGRAM
  N8N
  GOOGLE_DRIVE
}

model Integration {
  id         String          @id @default(cuid())
  orgId      String
  type       IntegrationType
  connected  Boolean         @default(false)
  config     Json? // non-secret metadata: botUsername, webhookUrl, events[], email
  secretEnc  String? // AES-256-GCM JSON blob; never logged, never returned raw
  lastSyncAt DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  organization Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  chats        TelegramChat[]
  messages     TelegramMessage[]
  events       IntegrationEvent[]

  @@unique([orgId, type])
}

model TelegramChat {
  id            String   @id @default(cuid())
  orgId         String
  integrationId String
  chatId        String // platform chat id as string
  title         String
  type          String // private | group | supergroup | channel
  createdAt     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, chatId])
  @@index([orgId])
}

model TelegramMessage {
  id            String   @id @default(cuid())
  orgId         String
  integrationId String
  chatId        String // platform chat id
  messageId     Int // platform message id
  fromName      String
  fromId        String?
  text          String?
  isCommand     Boolean  @default(false)
  sentAt        DateTime
  createdAt     DateTime @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, chatId, messageId])
  @@index([orgId, sentAt])
}

model IntegrationEvent {
  id        String   @id @default(cuid())
  orgId     String
  direction String // OUT | IN
  type      String // task.created | n8n.test | google.sync ...
  payload   Json?
  status    String   @default("OK") // OK | FAILED
  detail    String?
  createdAt DateTime @default(now())

  organization  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  integration   Integration? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  integrationId String?

  @@index([orgId, createdAt])
  @@index([orgId, direction])
}

// ---------- CRM (Sales) ----------

model Customer {
  id             String       @id @default(cuid())
  orgId          String
  name           String
  company        String?
  email          String?
  phone          String?
  notes          String?
  creatorId      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator      User         @relation("CustomerCreator", fields: [creatorId], references: [id])
  opportunities Opportunity[]

  @@index([orgId, name])
}

model Opportunity {
  id          String          @id @default(cuid())
  orgId       String
  number      Int
  customerId  String
  title       String
  value       Float           @default(0)
  stage       OpportunityStage @default(LEAD)
  expectedCloseAt DateTime?
  notes       String?
  ownerId     String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  owner        User         @relation("OpportunityOwner", fields: [ownerId], references: [id])

  @@unique([orgId, number])
  @@index([orgId, stage])
  @@index([customerId])
}

enum OpportunityStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

/// A company registration waiting for its owner to confirm the e-mail address (Phase 0 S1, reopened
/// with a check). Nothing in the app exists yet: no User, no Organization, so an unconfirmed request
/// can neither sign in nor hold an address another account needs. The confirmation link carries a
/// random token; only its SHA-256 is stored. Rows expire after 24 h and the hourly purge removes them.
model PendingRegistration {
  id           String   @id @default(cuid())
  email        String
  name         String
  jobTitle     String?
  orgName      String
  passwordHash String
  tokenHash    String   @unique
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([email])
  @@index([createdAt])
}