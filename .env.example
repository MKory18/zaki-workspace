# Zakai.io — متغيرات البيئة المطلوبة
# انسخ القيم الفعلية في Coolify (Environment)، ولا تضع أسرارًا حقيقية هنا.

# PostgreSQL (Coolify: استخدم خدمة Postgres الداخلية أو رابط خارجي)
DATABASE_URL="postgresql://user:password@host:5432/database"

# مفتاح توقيع الجلسات — ولّده بـ: openssl rand -hex 32
AUTH_SECRET=""

# اختياري — مفتاح تشفير أسرار التكاملات (تيليجرام / n8n / Google)، مستقل عن AUTH_SECRET (32 حرفًا فأكثر) — ولّده بـ: openssl rand -hex 32
# ENCRYPTION_KEY=

# عمر الجلسة بالساعات (افتراضي 168 = أسبوع)
SESSION_TTL_HOURS=168

# الرابط العام للتطبيق (يُستخدم في OAuth redirect)
APP_URL="https://your-domain.com"

# مستوى السجلات
LOG_LEVEL=info

# اختياري — عدد الـ reverse proxies التي تقف أمام التطبيق (عدد صحيح من 1 إلى 5، الافتراضي 1 = Traefik/Coolify وحده).
# هو الذي يحدّد أي عنوان في X-Forwarded-For يحسبه حدّ محاولات تسجيل الدخول كعنوان الزائر: يعدّ من اليمين
# بهذا العدد، فلا يستطيع الزائر اختيار عنوانه بإرسال الترويسة بنفسه.
# إن كان هناك CDN (مثل Cloudflare) أمام Traefik فاضبطه على 2، وإلا ظهر كل المستخدمين بعنوان واحد
# وتقاسموا حدّاً واحداً. لا تجعله أكبر من العدد الفعلي: يصبح العنوان المحسوب مما كتبه الزائر ويمكنه تخطي الحدّ.
# TRUSTED_PROXY_HOPS=1

# اختياري — تكامل Google Drive (قراءة فقط):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# اختياري — مجلد الملفات المرفوعة. على Docker/Coolify يُضبط تلقائياً على /app/storage/uploads
# (لازم يكون Persistent Storage). محلياً الافتراضي .data/uploads
# UPLOAD_DIR=

# للاختبارات على قاعدة بيانات حقيقية (npm run test:db): سيرفر Postgres محلي بصلاحية CREATEDB.
# يُنشأ داخله قاعدة مؤقتة لكل تشغيل وتُحذف بعدها. الافتراضي: DATABASE_URL مع اسم القاعدة postgres.
# TEST_DATABASE_ADMIN_URL=postgresql://zaki:zaki_local@localhost:5433/postgres
