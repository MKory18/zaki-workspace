# ---- Core ----
DATABASE_URL="postgresql://zaki:zaki@localhost:5433/zaki_workspace"
REDIS_URL="redis://localhost:6380/0"
APP_URL="http://localhost:3000"

# ---- Auth ----
AUTH_SECRET="replace-with-long-random-secret"
SESSION_TTL_HOURS="168"

# ---- File storage (local persistent volume in Docker) ----
STORAGE_DIR="./storage/uploads"
MAX_UPLOAD_MB="20"

# ---- Logging ----
LOG_LEVEL="info"

# ---- Worker ----
WORKER_CONCURRENCY="4"

# ---- Telegram (leave blank to disable; never commit real tokens) ----
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""

# ---- AI provider (OpenAI-compatible endpoint; blank disables AI) ----
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""
